<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mis Incidencias</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body class="app-body">

<aside class="sidebar-pro">
    <div class="brand">
        <div class="brand-icon">IT</div>
        <div>
            <h2>Incidencias TI</h2>
            <span>Soporte Empresarial</span>
        </div>
    </div>

    <nav>
        <a href="/">Dashboard</a>
        <a href="/nueva-incidencia">Nueva Incidencia</a>
        <a class="active" href="/mis-incidencias">Mis Incidencias</a>
        <a href="#">Historial</a>
    </nav>
</aside>

<main class="content-pro">

    <header class="topbar-pro">
        <div>
            <h1>Mis Incidencias</h1>
            <p>Consulta el estado de tus solicitudes reportadas</p>
        </div>
    </header>

    <section class="table-pro">
        <h3>Listado de incidencias</h3>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Prioridad</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                </tr>
            </thead>

            <tbody>
                <% if (incidencias.length === 0) { %>
                    <tr>
                        <td colspan="5">No hay incidencias registradas.</td>
                    </tr>
                <% } else { %>
                    <% incidencias.forEach((incidencia) => { %>
                        <tr>
                            <td>#<%= incidencia.CI_IdIncidencia %></td>
                            <td><%= incidencia.CT_Titulo %></td>
                            <td>
                                <span class="badge prioridad-<%= incidencia.CT_Prioridad.toLowerCase() %>">
                                    <%= incidencia.CT_Prioridad %>
                                </span>
                            </td>
                            <td>
                                <span class="badge estado-<%= incidencia.CT_Estado.toLowerCase().replace(' ', '-') %>">
                                    <%= incidencia.CT_Estado %>
                                </span>
                            </td>
                            <td><%= incidencia.CF_Fecha_Creacion.toISOString().slice(0,10) %></td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </section>

</main>

</body>
</html>