<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Sistema de Gestión de Incidencias TI</title>
</head>
<body>

    <h1>Sistema de Gestión de Incidencias TI</h1>

    <form action="/login" method="POST">

        <label>Usuario</label><br>
        <input type="text" name="usuario" required><br><br>

        <label>Contraseña</label><br>
        <input type="password" name="contrasena" required><br><br>

        <button type="submit">
            Iniciar Sesión
        </button>

    </form>

</body>
</html>