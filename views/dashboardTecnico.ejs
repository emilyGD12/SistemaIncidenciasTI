<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Dashboard Técnico</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>

<body class="app-body">

<aside class="sidebar-pro">
    <div class="brand">
        <div class="brand-icon">IT</div>
        <div>
            <h2>Incidencias TI</h2>
            <span>Panel Técnico</span>
        </div>
    </div>

    <nav>
        <a class="active" href="#">Dashboard</a>
        <a href="/incidencias-tecnico">Incidencias</a>
        <a href="#">En Proceso</a>
        <a href="#">Resueltas</a>
        <a href="/">Cerrar sesión</a>
    </nav>
</aside>

<main class="content-pro">

    <header class="topbar-pro">
        <div>
            <h1>Dashboard Técnico</h1>
            <p>Gestión, seguimiento y resolución de incidencias registradas</p>
        </div>

        <div class="profile-pro">
            <div class="avatar-pro">TS</div>
            <div>
                <strong><%= usuario.CT_Nombre %></strong>
                <span>Técnico de soporte</span>
            </div>
        </div>
    </header>

    <section class="stats-pro">

        <div class="stat-card blue-card">
            <span>Incidencias abiertas</span>
            <h2><%= abiertas %></h2>
            <p>Pendientes de revisión</p>
        </div>

        <div class="stat-card orange-card">
            <span>En proceso</span>
            <h2><%= enProceso %></h2>
            <p>Actualmente en atención</p>
        </div>

        <div class="stat-card green-card">
            <span>Resueltas</span>
            <h2><%= resueltas %></h2>
            <p>Casos finalizados</p>
        </div>

    </section>

    <section class="dashboard-layout">

    <div class="panel-pro">
        <div class="panel-header">
            <h3>Incidencias por prioridad</h3>
            <span>Alta · Media · Baja</span>
        </div>

        <div class="chart-container">
            <canvas id="graficoPrioridad"></canvas>
        </div>
    </div>

    <div class="panel-pro">
        <div class="panel-header">
            <h3>Incidencias por estado</h3>
            <span>Abierta · En proceso · Resuelta</span>
        </div>

        <div class="chart-container">
            <canvas id="graficoEstado"></canvas>
        </div>
    </div>

</section>

    <section class="table-pro">

        <h3>Resumen del sistema</h3>

        <table>
            <thead>
                <tr>
                    <th>Métrica</th>
                    <th>Valor</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>Incidencias abiertas</td>
                    <td><%= abiertas %></td>
                </tr>

                <tr>
                    <td>Incidencias en proceso</td>
                    <td><%= enProceso %></td>
                </tr>

                <tr>
                    <td>Incidencias resueltas</td>
                    <td><%= resueltas %></td>
                </tr>
            </tbody>
        </table>

    </section>

</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const baja = <%= baja %>;
    const media = <%= media %>;
    const alta = <%= alta %>;

    const abiertas = <%= abiertas %>;
    const enProceso = <%= enProceso %>;
    const resueltas = <%= resueltas %>;

    new Chart(document.getElementById('graficoPrioridad'), {
        type: 'doughnut',
        data: {
            labels: ['Baja', 'Media', 'Alta'],
            datasets: [{
                data: [baja, media, alta],
                backgroundColor: ['#22c55e', '#f97316', '#ef4444'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });

    new Chart(document.getElementById('graficoEstado'), {
        type: 'bar',
        data: {
            labels: ['Abiertas', 'En Proceso', 'Resueltas'],
            datasets: [{
                data: [abiertas, enProceso, resueltas],
                backgroundColor: ['#2563eb', '#f97316', '#22c55e'],
                borderRadius: 12
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            }
        }
    });
</script>

</body>
</html>