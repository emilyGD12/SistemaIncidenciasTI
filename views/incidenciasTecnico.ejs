<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Incidencias - Técnico</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body class="app-body">

<aside class="sidebar-pro">
    <div class="brand">
        <div class="brand-icon">IT</div>
        <div>
            <h2>Incidencias TI</h2>
            <span>Panel Técnico</span>
        </div>
    </div>

    <nav>
        <a href="#">Dashboard</a>
        <a class="active" href="/incidencias-tecnico">Incidencias</a>
        <a href="#">En Proceso</a>
        <a href="#">Resueltas</a>
        <a href="/">Cerrar sesión</a>
    </nav>
</aside>

<main class="content-pro">

    <header class="topbar-pro">
        <div>
            <h1>Gestión de Incidencias</h1>
            <p>Listado general de incidencias registradas en el sistema</p>
        </div>
    </header>

    <section class="table-pro">

        <h3>Todas las incidencias</h3>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Prioridad</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>

            <tbody>

                <% if (incidencias.length === 0) { %>

                    <tr>
                        <td colspan="5">
                            No hay incidencias registradas.
                        </td>
                    </tr>

                <% } else { %>

                    <% incidencias.forEach((incidencia) => { %>

                    <tr>

                        <td>
                            #<%= incidencia.CI_IdIncidencia %>
                        </td>

                        <td>
                            <%= incidencia.CT_Titulo %>
                        </td>

                        <td>
                            <span class="badge prioridad-<%= incidencia.CT_Prioridad.toLowerCase() %>">
                                <%= incidencia.CT_Prioridad %>
                            </span>
                        </td>

                        <td>
                            <span class="badge estado-<%= incidencia.CT_Estado.toLowerCase().replace(' ', '-') %>">
                                <%= incidencia.CT_Estado %>
                            </span>
                        </td>

                        <td>

                            <button
                                class="btn-primary"
                                onclick="window.location.href='/gestionar-incidencia/<%= incidencia.CI_IdIncidencia %>'">

                                Gestionar

                            </button>

                        </td>

                    </tr>

                    <% }) %>

                <% } %>

            </tbody>

        </table>

    </section>

</main>

</body>
</html>